# npm run db:local creates .env.local with random LOCAL-ONLY credentials.
APP_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
DATABASE_URL=
AUTH_DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_AUTH_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
SEED_PASSWORD=
# Local checks are not full antivirus. Set true to block processing until a real scanner is implemented.
UPLOAD_REQUIRE_ANTIVIRUS=false
