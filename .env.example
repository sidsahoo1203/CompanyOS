# Local development: npm run db:local creates .env.local with random LOCAL-ONLY
# credentials. Never commit .env.local.
APP_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
DATABASE_URL=
AUTH_DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_AUTH_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
SEED_PASSWORD=
# Local checks are not full antivirus. Set true to block processing until a real scanner is implemented.
UPLOAD_REQUIRE_ANTIVIRUS=false

# Hosted (Render) deployment: set these in the host's environment settings,
# never in a file. See docs/deployment-render.md.
# APP_MODE=production
# BETTER_AUTH_URL=https://your-domain.example      (public origin, no trailing slash)
# BETTER_AUTH_SECRET=                                (32+ random characters)
# MIGRATION_DATABASE_URL=                            (managed database owner URL)
# APP_DB_PASSWORD=                                   (24+ random characters)
# AUTH_DB_PASSWORD=                                  (24+ random characters)
# RESEND_API_KEY=re_...
# EMAIL_FROM=CompanyOS <no-reply@your-domain.example>
